# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file or share it - it contains your secret key.

# Dashboard -> Developers -> API keys -> "Secret key"
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# The Price ID of your monthly membership product.
# Dashboard -> Product catalog -> your product -> copy the Price ID (starts with price_)
STRIPE_PRICE_ID=price_REPLACE_ME

# Dashboard -> Developers -> Webhooks -> your endpoint -> "Signing secret"
# (you'll create the webhook endpoint after deploying this server - see README)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Port the server listens on (Render/Railway set this automatically in production)
PORT=4242

# Protects the /admin/support inbox page (view + reply to driver support
# messages). Pick any long random string - anyone with this value can read
# every driver's support thread, so keep it secret.
ADMIN_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# From Google Cloud Console -> APIs & Services -> Credentials -> your
# "Web application" OAuth client (NOT the Android one - Sign in with Google
# via Credential Manager verifies against the Web client's ID).
# See README.md Part 7 for the full walkthrough.
GOOGLE_WEB_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
